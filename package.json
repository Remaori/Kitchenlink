{
  "name": "kitchenlink",
  "version": "0.1.0",
  "private": true,
  "description": "KitchenLink · Sistema de gestión de restaurante (React + Node.js/Express + PostgreSQL)",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:red": "node scripts/dev.mjs --red",
    "dev:api": "npm run dev -w backend",
    "dev:web": "npm run dev -w frontend",
    "build": "npm run build -w frontend",
    "test": "npm test -w backend",
    "env:crear": "npm run env:crear -w backend",
    "db:instalar": "npm run db:instalar -w backend --",
    "db:conectividad": "npm run db:conectividad -w backend --",
    "usuario:gerente": "npm run usuario:gerente -w backend --",
    "usuario:restablecer": "npm run usuario:restablecer -w backend --"
  }
}
