# =====================================================================
#  KitchenLink · backend/.env
#  Copia este archivo como .env  (o ejecuta: npm run env:crear, que lo
#  copia y genera JWT_SECRET y DB_PASSWORD al azar).
#  El .env NUNCA se sube a GitHub (está en .gitignore).
# =====================================================================

NODE_ENV=development
PORT=3000

# --- PostgreSQL 16 ----------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kitchenlink
# Usuario con el que se conecta la aplicación (lo crea npm run db:instalar).
# No lo cambies: 02_permisos_app.sql le da permisos a este nombre.
DB_USER=kitchenlink_app
DB_PASSWORD=

# Usuario administrador de PostgreSQL. SOLO lo usan los scripts de
# instalación (crear base, rol y esquema). Es la contraseña que pusiste
# al instalar PostgreSQL.
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=

# Zona horaria del restaurante (reportes por hora, corte del día)
ZONA_HORARIA=America/Mexico_City

# --- Sesiones ------------------------------------------------------------
# Clave para firmar los JWT. Mínimo 32 caracteres al azar.
JWT_SECRET=
# Duración de la sesión (un turno)
SESION_HORAS=12
# La cookie solo viaja por HTTPS. Vacío: true con NODE_ENV=production (detrás de
# Nginx) y false en desarrollo. Escribe true o false solo para forzarlo.
COOKIE_SECURE=
# Costo de bcrypt (12 ≈ 0.3 s por intento)
BCRYPT_COSTO=12

# Intentos fallidos permitidos en la ventana de minutos (por usuario y por equipo)
INTENTOS_MAX=5
INTENTOS_MAX_EQUIPO=20
INTENTOS_VENTANA_MIN=15

# --- Cronograma (interruptor por fecha) ----------------------------------
# Cada módulo aparece el miércoles en que se revisa (ver docs/CRONOGRAMA.md).
# Vacío = la fecha de hoy. Mejor sin tocarlo: `npm run demo:todo` (todo) o
# `npm run demo -- --fecha 2026-10-28` solo valen para esa vez.
# `npm run cronograma` muestra qué se ve.
FECHA_REVISION=

# --- Reloj de demostración --------------------------------------------------
# No hace falta tocarlo: `npm run demo` ya arranca a la hora de los datos de
# demostración (martes 22 de septiembre, 19:09). Solo para otros comandos:
#   RELOJ_INICIO=2026-09-22T19:09:00-06:00
# Vacío = la hora real (lo normal en el restaurante).
# RELOJ_CORRE=false lo deja detenido (para comparar con el PDF del diseño).
RELOJ_INICIO=
RELOJ_CORRE=true

# --- Impresora térmica de caja (ESC/POS por red) --------------------------
# IP de la impresora (puerto 9100). Vacío = imprime el navegador.
IMPRESORA_HOST=
IMPRESORA_PUERTO=9100
