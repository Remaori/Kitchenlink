# =====================================================================
#  KitchenLink · backend/.env
#  Copia este archivo como .env  (o ejecuta: npm run env:crear, que lo
#  copia y genera JWT_SECRET y DB_PASSWORD al azar).
#  El .env NUNCA se sube a GitHub (está en .gitignore).
# =====================================================================

NODE_ENV=development
PORT=3000

# --- PostgreSQL 16 ----------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kitchenlink
# Usuario con el que se conecta la aplicación (lo crea npm run db:instalar).
# No lo cambies: 02_permisos_app.sql le da permisos a este nombre.
DB_USER=kitchenlink_app
DB_PASSWORD=

# Usuario administrador de PostgreSQL. SOLO lo usan los scripts de
# instalación (crear base, rol y esquema). Es la contraseña que pusiste
# al instalar PostgreSQL.
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=

# Zona horaria del restaurante (reportes por hora, corte del día)
ZONA_HORARIA=America/Mexico_City

# --- Sesiones ------------------------------------------------------------
# Clave para firmar los JWT. Mínimo 32 caracteres al azar.
JWT_SECRET=
# Duración de la sesión (un turno)
SESION_HORAS=12
# true cuando la app se sirve por HTTPS (detrás de Nginx). En desarrollo, false.
COOKIE_SECURE=false
# Costo de bcrypt (12 ≈ 0.3 s por intento)
BCRYPT_COSTO=12

# Intentos fallidos permitidos en la ventana de minutos (por usuario y por equipo)
INTENTOS_MAX=5
INTENTOS_MAX_EQUIPO=20
INTENTOS_VENTANA_MIN=15
